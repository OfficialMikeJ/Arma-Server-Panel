{
  "name": "arma-server-panel",
  "version": "1.0.0",
  "private": true,
  "description": "Arma Server Panel - specialized game server hosting control panel for Arma Reforger, Arma 3 and Arma 4",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "npm run build -w @asp/shared && npm run build -w @asp/api && npm run build -w @asp/web",
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @asp/api",
    "dev:web": "npm run dev -w @asp/web",
    "db:generate": "npm run db:generate -w @asp/api",
    "db:migrate": "npm run db:migrate -w @asp/api",
    "db:deploy": "npm run db:deploy -w @asp/api",
    "db:seed": "npm run db:seed -w @asp/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
