###############################################################################
# Arma Server Panel - environment
#
# Copy to .env and fill in. The API refuses to start if anything here is
# missing, weak, or left at a placeholder value.
#
# Generate each 32-byte key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
###############################################################################

NODE_ENV=development
LOG_LEVEL=info

# --- Where things live -------------------------------------------------------
# The API binds to loopback by default. Put a TLS-terminating reverse proxy in
# front of it; do not bind it to 0.0.0.0 directly.
API_HOST=127.0.0.1
API_PORT=4000

# Canonical public origin of the web app. Must be https in production.
PUBLIC_APP_URL=http://localhost:3000
# Only set if the API is served from a different origin than the web app.
# PUBLIC_API_URL=https://api.example.com

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://asp:CHANGE_ME@localhost:5432/arma_server_panel?schema=public

# --- Secrets (REQUIRED, 64 hex characters each) ------------------------------
# Encrypts TOTP seeds, RCON passwords, webhook URLs and AI API keys at rest.
ENCRYPTION_KEY=
# Salts IP and user-agent hashes so a database leak cannot be reversed.
# MUST be different from ENCRYPTION_KEY.
HASH_PEPPER=
# Set only while rotating ENCRYPTION_KEY, so old envelopes still decrypt.
# ENCRYPTION_KEY_PREVIOUS=

# --- Optional: Redis for distributed rate limiting ---------------------------
# Without this, rate limit counters live in Postgres, which is fine for a
# single-instance deployment.
# REDIS_URL=redis://localhost:6379

# --- Discord sign-in (optional) ----------------------------------------------
# Set both or neither. Redirect URI: <PUBLIC_APP_URL>/auth/discord/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# --- Container runtime -------------------------------------------------------
DOCKER_SOCKET=/var/run/docker.sock
# For a remote daemon, use https + client certificates. Plain TCP is refused.
# DOCKER_HOST=https://node1.internal:2376
# DOCKER_TLS_CA=/etc/asp/docker/ca.pem
# DOCKER_TLS_CERT=/etc/asp/docker/cert.pem
# DOCKER_TLS_KEY=/etc/asp/docker/key.pem

# Root directory for game server volumes. Needs to be on the 120 GB+ filesystem.
DATA_ROOT=/var/lib/arma-server-panel/servers

# --- Game hosting ------------------------------------------------------------
# Public address players connect to. Leave unset to auto-detect.
# PUBLIC_GAME_HOST=play.example.com

# Steam credentials for downloading the Arma 3 dedicated server package.
# Reforger does not need these. Use a dedicated account with no purchases and
# Steam Guard disabled, not your personal account.
# STEAM_USERNAME=
# STEAM_PASSWORD=

# --- Relay (keeps a self-hoster's home IP private) ---------------------------
# Deploy the relay daemon from services/relay/ onto a VPS with a public IP,
# then point these at it. Without a relay, direct port forwarding exposes the
# operator's own IP address to players.
RELAY_ENABLED=false
# RELAY_ENDPOINT=https://relay.example.com
# RELAY_TOKEN=

# --- Host requirement check --------------------------------------------------
# 50 Mbps up/down is a hard requirement. These endpoints measure it.
SPEEDTEST_DOWNLOAD_URL=https://speed.cloudflare.com/__down?bytes=52428800
SPEEDTEST_UPLOAD_URL=https://speed.cloudflare.com/__up
# Air-gapped installs only: operator-attested throughput, recorded as declared
# rather than measured.
# SPEEDTEST_MANUAL_DOWNLOAD_MBPS=1000
# SPEEDTEST_MANUAL_UPLOAD_MBPS=1000

# --- Proxy ------------------------------------------------------------------
# Only enable behind a reverse proxy you control, and list its addresses.
# Otherwise X-Forwarded-For is attacker-controlled and every rate limit,
# lockout and audit entry becomes forgeable.
TRUST_PROXY=false
TRUSTED_PROXY_CIDRS=

# Never set false in production.
REQUIRE_SECURE_COOKIES=true

###############################################################################
# Web app (apps/web)
###############################################################################
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
